/* ===================================================================
   Robot Configuration & Constants
   =================================================================== */

// Servo ports
#define CLAW 2
#define ARM  3

// Motor ports
#define MOTORl 3
#define MOTORr 0

// Line sensors (analog)
#define SENSORl 5
#define SENSORr 2

// Sensor thresholds
#define BLACK 3000
#define WHITE 2000

// Motor correction factor for right motor (to compensate mechanical differences)
#define RIGHT_MOTOR_CORRECTION 1.002

// Motor speeds (arbitrary units for mav)
#define MOTOR_SPEED_250  250
#define MOTOR_SPEED_500  500
#define MOTOR_SPEED_1000 1000
#define MOTOR_SPEED_1500 1500

// Claw servo positions (pulse widths)
#define CLAW_UPPER_OPEN 450
#define CLAW_OPEN       550
#define CLAW_CLOSE      1130
#define CLAW_DOOR       1080
#define CLAW_BOTGUY     874
#define CLAW_CONE       560

// Arm servo positions
#define ARM_BOTGUY        1500
#define ARM_CONE          1940
#define ARM_BOTGUY_CARRY  402
#define ARM_UP            820
#define ARM_START         160
#define ARM_DOWN_BOTGUY   1750
#define ARM_DOOR          1630
#define ARM_CONE_UP       500

// Line following distances (encoder ticks)
#define TO_BOTGUY_LINE_FOLLOW 4100
#define RETURN_LINE_FOLLOW    11500

// Misc
#define DEGREES 5

/* ===================================================================
   Basic Motion Primitives
   =================================================================== */

/**
 * Drive both motors at given speeds (left, right).
 * Right motor speed is multiplied by correction factor.
 */
void drive(int speed1, int speed2) {
    mav(MOTORl, speed1);
    mav(MOTORr, speed2 * RIGHT_MOTOR_CORRECTION);
}

/* ===================================================================
   Servo Control (Arm & Claw)
   =================================================================== */

/**
 * Move arm servo to end_pos smoothly (incremental steps).
 */
void move_arm(int end_pos) {
    enable_servos();
    int current_pos = get_servo_position(ARM);
    while (current_pos != end_pos) {
        if (current_pos > end_pos) {
            current_pos -= 10;
            if (current_pos < end_pos) current_pos = end_pos;
        } else {
            current_pos += 10;
            if (current_pos > end_pos) current_pos = end_pos;
        }
        set_servo_position(ARM, current_pos);
        msleep(15);
    }
    disable_servos();
}

/**
 * Move claw servo to end_pos smoothly (incremental steps).
 */
void move_claw(int end_pos) {
    enable_servos();
    int current_pos = get_servo_position(CLAW);
    while (current_pos != end_pos) {
        if (current_pos > end_pos) {
            current_pos -= 30;
            if (current_pos < end_pos) current_pos = end_pos;
        } else {
            current_pos += 30;
            if (current_pos > end_pos) current_pos = end_pos;
        }
        set_servo_position(CLAW, current_pos);
        msleep(60);
    }
    disable_servos();
}

/**
 * Move arm to position with a fast initial jump then fine adjustment.
 * This reduces settling time.
 */
void move_arm_fast_slow_down(int position) {
    enable_servos();
    set_servo_position(ARM, position - 500);
    disable_servos();
    enable_servos();
    msleep(100);
    move_arm(position);
    msleep(100);
}

/* ===================================================================
   Line Detection & Driving Until Condition
   =================================================================== */

/**
 * Drive forward until both sensors see black, with a timeout.
 */
void drive_till_blk_time(int timeout_secs) {
    int start_time = seconds();
    while (analog(SENSORl) <= BLACK || analog(SENSORr) <= BLACK) {
        if (seconds() - start_time >= timeout_secs) break;
        drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    }
    ao();
}

/**
 * Drive forward until both sensors see black (no timeout).
 */
void drive_till_blk() {
    while (analog(SENSORl) <= BLACK || analog(SENSORr) <= BLACK) {
        drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    }
    ao();
}

/**
 * Drive forward at given speed until both sensors see black.
 */
void drive_till_blk_speed(int speed) {
    while (analog(SENSORl) <= BLACK || analog(SENSORr) <= BLACK) {
        drive(speed, speed);
    }
    ao();
}

/**
 * Drive forward until both sensors see white, with a timeout.
 */
void drive_till_white(int timeout_secs) {
    int start_time = seconds();
    while (analog(SENSORl) >= WHITE || analog(SENSORr) >= WHITE) {
        if (seconds() - start_time >= timeout_secs) break;
        drive(MOTOR_SPEED_1000, MOTOR_SPEED_1000);
    }
    ao();
}

/**
 * Drive backward until both sensors see black.
 */
void back_till_blk() {
    while (analog(SENSORl) <= BLACK && analog(SENSORr) <= BLACK) {
        drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    }
    ao();
}

/* ===================================================================
   Turns (Fixed Degrees)
   =================================================================== */

/**
 * Turn right a given number of degrees at normal speed.
 * Conversion: 12.7 encoder ticks per degree (approximate).
 */
void right_degrees(int degrees) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    int ticks = 12.7 * degrees;
    while (gmpc(MOTORl) < ticks || gmpc(MOTORr) > -ticks) {
        drive(MOTOR_SPEED_500, -MOTOR_SPEED_500);
    }
    ao();
    msleep(50);
}

/**
 * Turn right a given number of degrees at a higher speed.
 */
void right_degrees_speed(int degrees) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    int ticks = 12.7 * degrees;
    while (gmpc(MOTORl) < ticks || gmpc(MOTORr) > -ticks) {
        drive(MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    }
    ao();
    msleep(50);
}

/**
 * Turn right a small number of degrees using a finer tick conversion.
 */
void right_degrees_less(int degrees) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    int ticks = 2 * degrees;
    while (gmpc(MOTORl) < ticks || gmpc(MOTORr) > -ticks) {
        drive(MOTOR_SPEED_500, -MOTOR_SPEED_500);
    }
    ao();
    msleep(50);
}

/**
 * Turn left a given number of degrees at normal speed.
 */
void left_degrees(int degrees) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    int ticks = 12.7 * degrees;
    while (gmpc(MOTORl) > -ticks || gmpc(MOTORr) < ticks) {
        drive(-MOTOR_SPEED_500, MOTOR_SPEED_500);
    }
    ao();
    msleep(50);
}

/**
 * Turn left a small number of degrees using a finer tick conversion.
 */
void left_degrees_less(int degrees) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    int ticks = 2 * degrees;
    while (gmpc(MOTORl) > -ticks || gmpc(MOTORr) < ticks) {
        drive(-MOTOR_SPEED_500, MOTOR_SPEED_500);
    }
    ao();
    msleep(50);
}

/* ===================================================================
   Line Following
   =================================================================== */

/**
 * Simple twobsensor line follower.
 * Follows a black line on a white background for a given distance (encoder ticks).
 * Uses a proportional correction based on which sensor sees black.
 */
void line_follow(int distance, int speed) {
    int high = speed;
    int low  = 0.6 * speed;

    cmpc(MOTORl);
    cmpc(MOTORr);
    msleep(100);

    while (abs(gmpc(MOTORl)) < distance || abs(gmpc(MOTORr)) < distance) {
        int sl = analog(SENSORl);
        int sr = analog(SENSORr);

        if (sl >= BLACK && sr >= BLACK) {
            drive(high, high);       // both on line b go straight
        } else if (sl >= BLACK) {
            drive(low, high);        // left on line b turn left
        } else if (sr >= BLACK) {
            drive(high, low);        // right on line b turn right
        } else {
            drive(high, high);       // lost line b go straight
        }
        msleep(1);
    }
    ao();
    msleep(50);
}

/**
 * Improved line follower using proportional steering.
 * Error = left_sensor - right_sensor (analog values), then speed_modifier = error * CORRECTION.
 */
#define CORRECTION 0.3
void line_follow_2(int distance, int speed) {
    cmpc(MOTORl);
    cmpc(MOTORr);
    msleep(50);

    while ((abs(gmpc(MOTORl)) + abs(gmpc(MOTORr))) / 2.0 < distance) {
        int left_val  = analog(SENSORl);
        int right_val = analog(SENSORr);

        int error = left_val - right_val;
        float speed_modifier = error * CORRECTION;

        mav(MOTORr, speed + speed_modifier);
        mav(MOTORl, speed - speed_modifier);

        msleep(5);
    }
    ao();
    msleep(50);
}

/* ===================================================================
   HighbLevel Mission Steps
   =================================================================== */

/**
 * Navigate from start to the position where the "botguy" is located.
 * This includes a sequence of drives and turns, followed by a linebfollow segment.
 */
void move_to_botguy() {
    enable_servos();
    move_arm(ARM_START);
    move_claw(CLAW_DOOR);

    drive_till_blk();
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(1300);
    right_degrees(46);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(2700);
    left_degrees(45);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(400);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(400);
    ao();
    right_degrees(66);

    line_follow(TO_BOTGUY_LINE_FOLLOW, MOTOR_SPEED_1500);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(600);
    left_degrees(50);
    drive(MOTOR_SPEED_500, MOTOR_SPEED_500);
    msleep(500);
    left_degrees(60);
    right_degrees(28);
    ao();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(670);
    left_degrees(2);
    ao();
}

/**
 * Open the doors (presumably a mechanism) and grab the botguy.
 * Uses arm and claw sequences, plus finebtuning turns.
 */
void open_doors() {
    move_arm_fast_slow_down(ARM_DOOR);
    line_follow(50, MOTOR_SPEED_500);
    right_degrees_speed(35);
    move_arm(ARM_DOWN_BOTGUY);
    msleep(50);
    drive(MOTOR_SPEED_1000, MOTOR_SPEED_1000);
    msleep(10);
    left_degrees(40);
    ao();
    msleep(100);
    left_degrees(20);
    right_degrees(35);
    left_degrees(7);
    msleep(100);
    disable_servos();
    msleep(300);
    ao();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(400);
    ao();
    move_arm(ARM_DOWN_BOTGUY);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(250);
    ao();
    enable_servos();
    //msleep(300);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(40);
    set_servo_position(CLAW, CLAW_OPEN);
    msleep(200);
    //right_degrees_less(1);
    left_degrees(2);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(250);
    ao();
    msleep(300);
    set_servo_position(CLAW, CLAW_CLOSE);
    move_arm(ARM_BOTGUY);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(300);
    ao();
    left_degrees_less(1);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(1450);
    drive(-MOTOR_SPEED_1000, -MOTOR_SPEED_1000);
    msleep(1000);
    ao();
    printf("move(arm_botguy_carry) moving up");
    move_arm(ARM_BOTGUY_CARRY);
}

/**
 * Deliver the botguy to the designated area.
 * Involves driving, line following, and releasing the botguy.
 */
void deliver_botguy() {
    drive_till_blk();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(300);
    right_degrees(82);
    drive_till_blk_time(1);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(300);
    drive_till_blk();
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(3500);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(300);
    left_degrees(88);
    drive(MOTOR_SPEED_1000, MOTOR_SPEED_1000);
    msleep(1000);
    move_arm(ARM_UP);
    left_degrees(190);
    drive_till_blk_speed(MOTOR_SPEED_1000);
    drive(MOTOR_SPEED_500, MOTOR_SPEED_500);
    msleep(400);
    ao();
    enable_servos();
    set_servo_position(CLAW, CLAW_OPEN);
    msleep(200);
    left_degrees(5);
    set_servo_position(CLAW, CLAW_UPPER_OPEN);
    msleep(300);
    right_degrees(5);
    disable_servos();
}

/**
 * Collect the two cones.
 * Uses arm/claw, line following, and returns to a known position.
 */
void get_cones() {
    move_arm(ARM_UP);
    move_claw(CLAW_OPEN);
    enable_servos();

    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(600);
    back_till_blk();
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(900);
    right_degrees(95);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(1200);
    ao();
    right_degrees(5);
    move_arm(ARM_CONE);
    line_follow_2(450, MOTOR_SPEED_1500);
    
    // Now go to second cone
    line_follow_2(3300, MOTOR_SPEED_1500);
    //TEMPORARY
    right_degrees(DEGREES-2);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(1200);
    ao();
    enable_servos();
    set_servo_position(CLAW, CLAW_CLOSE);
    msleep(1000);
    msleep(200);
    move_arm(ARM_UP);
    left_degrees(DEGREES);
    msleep(200);
    line_follow_2(RETURN_LINE_FOLLOW, MOTOR_SPEED_1500);
    right_degrees(90);
    back_till_blk();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(400);
    back_till_blk();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(1700);
    drive(MOTOR_SPEED_1000, MOTOR_SPEED_1000);
    msleep(200);
    right_degrees(90);
    drive_till_blk_time(0.25);
    line_follow_2(15200, MOTOR_SPEED_1500);
    drive_till_white(0.5);
}

/**
 * Final parking manoeuvre after collecting cones.
 * Includes turns, line detection, and arm/claw positioning.
 */
void parking() {
    right_degrees(5);
    ao();
    move_arm_fast_slow_down(ARM_CONE);
    enable_servos();
    set_servo_position(CLAW, CLAW_UPPER_OPEN);
    msleep(200);
    set_servo_position(ARM, ARM_UP);
    msleep(500);
    set_servo_position(CLAW, CLAW_CLOSE);
    msleep(500);
    disable_servos();

    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(870);
    back_till_blk();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(1000);
    left_degrees(33);
    drive_till_blk_time(0.5);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(1470);
    back_till_blk();
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(1330);
    left_degrees(145);
    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(3200);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(300);
    right_degrees(100);

    drive(-MOTOR_SPEED_1500, -MOTOR_SPEED_1500);
    msleep(200);
    drive(MOTOR_SPEED_1500, MOTOR_SPEED_1500);
    msleep(300);
    right_degrees(10);
}

/* ===================================================================
   Main
   =================================================================== */

int main() {
    move_to_botguy();
    open_doors();
    deliver_botguy();
    get_cones();
    parking();

    return 0;
}
