}

void move_arm_fast_slow_down(int position) {        
    enable_servos();
    set_servo_position(ARM,position-500);
    disable_servos();
    enable_servos();
    msleep(100);
    move_arm(position);
    msleep(100);
}  

void move_arm_fast_slow_up(int position) {
    enable_servos();
    set_servo_position(ARM, position + 500);
    enable_servos();
    msleep(100);
    move_arm(position);
    msleep(100);
}


void right_turn() {
    printf("RIGHT TURN");
    cmpc(MOTORl);
    cmpc(MOTORr);
    while(gmpc(MOTORl) > -1000 && gmpc(MOTORr) > -1000){
        drive(MOTOR_SPEED_500, -MOTOR_SPEED_500);
    }
    ao();
    msleep(50);
}
