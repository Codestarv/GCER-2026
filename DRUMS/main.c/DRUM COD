void move_storage(int distance, int speed) {
    cmpc(STORAGE_MOTOR);
    while((gmpc(STORAGE_MOTOR) < distance)) {
        printf("GMPC: motor_position=%d\n", gmpc(STORAGE_MOTOR));
        mav(STORAGE_MOTOR, speed);
    }
}

void move_storage2(int distance, int speed) {
    cmpc(STORAGE_MOTOR);                    // clear position counter to 0

    int dir = (distance >= 0) ? 1 : -1;     // spin direction from sign of distance
    speed = abs(speed) * dir;               // force speed to match that direction

    mav(STORAGE_MOTOR, speed);              // set velocity ONCE

    while (abs(gmpc(STORAGE_MOTOR)) < abs(distance)) {
        msleep(10);                         // poll ~100x/sec, don't busy-spin
    }

    freeze(STORAGE_MOTOR);                  // stop and actively hold position
    msleep(50);                             // let it settle before next action
}
