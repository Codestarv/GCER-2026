#define BLUE_MOVE_DRUM -940
#define PINK_MOVE_DRUM -840
void put_drum_storage_both(int COLOR) {
    int MOVE_DRUM = (COLOR == 0) ? BLUE_MOVE_DRUM : PINK_MOVE_DRUM;
    enable_servos();
    msleep(100);                          // small settle (was 100 + 200)

    move_arm_fast(ARM_UP_STORAGE);        // lift the drum -- LOADED, watch for fling
    move_drum(MOVE_DRUM, MOTOR_SPEED_500);

    move_arm_fast(ARM_DOWN_STORAGE);      // lower to drop (controlled, not an instant slam)
    set_servo_position(CLAW, CLAW_OPEN);  // release
    msleep(300);                          // claw opens + drum falls clear (was 500) -- VERIFY

    move_arm_fast(ARM_UP_STORAGE);        // arm now EMPTY -> fast is risk-free
    move_drum(-MOVE_DRUM + 5, MOTOR_SPEED_500);
    move_arm_fast(ARM_DOWN);              // back to grab position, empty
}
void move_storage(int distance, int speed) {
    cmpc(STORAGE_MOTOR);
    while((gmpc(STORAGE_MOTOR) < distance)) {
        printf("GMPC: motor_position=%d\n", gmpc(STORAGE_MOTOR));
        mav(STORAGE_MOTOR, speed);
    }
}

void move_storage2(int distance, int speed) {
    cmpc(STORAGE_MOTOR);                    // clear position counter to 0

    int dir = (distance >= 0) ? 1 : -1;     // spin direction from sign of distance
    speed = abs(speed) * dir;               // force speed to match that direction

    mav(STORAGE_MOTOR, speed);              // set velocity ONCE

    while (abs(gmpc(STORAGE_MOTOR)) < abs(distance)) {
        msleep(10);                         // poll ~100x/sec, don't busy-spin
    }

    freeze(STORAGE_MOTOR);                  // stop and actively hold position
    msleep(50);                             // let it settle before next action
}
#define FIRST_DRUM_TIME 10   // s, ADDS starts dispensing
#define DRUM_INTERVAL    7.0   // s between drops
#define DRUM_SETTLE      1  // small cushion after release

double start_time;   // set at match start (after wait_for_light)

// wait until drum N (1-indexed) has been released
void wait_for_drum(int n) {
    double release = FIRST_DRUM_TIME + DRUM_INTERVAL * (n - 1) + DRUM_SETTLE;
    while (seconds() - start_time < release) {
        msleep(10);
    }
    printf("Drum %d ready at t=%.1fs\n", n, seconds() - start_time);
}

// Returns true if the drum in view is BLUE, false if PINK.
// Averages several frames, ignores near-ties (noise), and re-looks once
// if it saw essentially nothing before committing to a default.
bool drum_is_blue() {
    msleep(100);

    for (int attempt = 0; attempt < 2; attempt++) {
        int pink_area = 0;
        int blue_area = 0;

        // average a few frames so one bad read doesn't decide it
        for (int i = 0; i < 5; i++) {
            camera_update();

            if (get_object_count(PINK_CAMERA_CHANNEL) > 0) {
                pink_area += get_object_area(PINK_CAMERA_CHANNEL, 0);
            }
            if (get_object_count(BLUE_CAMERA_CHANNEL) > 0) {
                blue_area += get_object_area(BLUE_CAMERA_CHANNEL, 0);
            }

            msleep(30);
        }

        printf("PINK area = %d, BLUE area = %d (attempt %d)\n",
               pink_area, blue_area, attempt);

        // If we basically saw nothing, the drum may not be settled/in view yet.
        // Only re-look on the first attempt; costs ~250ms and only when ambiguous.
        if (pink_area < 50 && blue_area < 50 && attempt == 0) {
            printf("drum_is_blue(): nothing seen, re-looking...\n");
            msleep(80);
            continue;
        }

        return (blue_area > pink_area);
    }

    // Fallback: never got a confident read. Default to PINK and flag it loudly.
    printf("drum_is_blue(): NO CONFIDENT READ -> defaulting PINK\n");
    return false;
}
void go_to_post() {
    enable_servos();
    set_servo_position(PINK_CLAW,PINK_CLOSE);
    msleep(250);
    move_arm(ARM_UP);
    back_till_blk();
    drive(-MOTOR_SPEED_1500,-MOTOR_SPEED_1500);
    msleep(600);
    back_till_blk();
    drive(MOTOR_SPEED_1500,MOTOR_SPEED_1500);
    msleep(900);
    left_degrees(80);
    drive(-MOTOR_SPEED_1500,-MOTOR_SPEED_1500);
    msleep(1500);
    line_follow(1000,MOTOR_SPEED_1000);
    right_degrees(76.8);
    move_storage2(STORAGE_DISTANCE,MOTOR_SPEED_1500);
    msleep(40);
    drive(-MOTOR_SPEED_1000,-MOTOR_SPEED_1000);
    msleep(3200);
    drive(MOTOR_SPEED_500,MOTOR_SPEED_500);
    msleep(500);
    freeze(MOTORl);
    freeze(MOTORr);
    msleep(5000);
    enable_servos();
    set_servo_position(PINK_CLAW,PINK_OPEN);

}

void go_to_second_post() {
    drive_till_blk();
    drive(1500,1500);
    msleep(500);
    drive_till_blk();
    drive(1000,1000);
    msleep(600);
    right_degrees(90);
    line_follow(12000,MOTOR_SPEED_1500);
}

// Grab the drum first (so it's secured and stable), then read its color,
// then store it. Doing it in this order everywhere makes detection consistent
// and keeps a moving/just-dropped drum from being misread.
void handle_one_drum() {
    grab_drum();
    if (drum_is_blue()) {
        printf("BLUE\n");
        put_drum_storage_both(0);
    } else {
        printf("PINK\n");
        put_drum_storage_both(1);
    }
}

int main() {
    start_time = seconds();
    camera_open();
    enable_servos();                 // enable once; servos stay enabled all match so the arm holds
    set_servo_position(PINK_CLAW, PINK_CLOSE);
    set_servo_position(BLUE_CLAW, BLUE_CLOSE);
    go_to_drums();

    wait_for_drum(1);
    handle_one_drum();               // drum 1 (same grab->detect->store order as the loop)

    for (int i = 2; i <= 8; i++) {
        wait_for_drum(i);
        printf("Drum %d of 8\n", i);
        handle_one_drum();
    }

    camera_close();

    go_to_post();
}
