    }
    disable_servos();
    printf("move_claw(End): current_pos= %d, end_pos= %d\n", current_pos, end_pos);
}

void move_arm_fast_slow_down(int position) {        
    enable_servos();
    set_servo_position(ARM,position-500);
    disable_servos();
    enable_servos();
    msleep(100);
    move_arm(position);
    msleep(100);
}  




