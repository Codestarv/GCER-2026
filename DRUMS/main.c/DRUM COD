            //if (get_object_area(CAMERA_CHANNEL) > 20 {
            return true;
            printf("PINK DETECTED !\n");
            // }
        }

        msleep(30);
    }

    printf("No pink detected.\n");
    return false;
}
bool detect_pink_duplicate() {
    const int AREA_THRESHOLD = 10;

    msleep(100);

    for (int i = 0; i < 10; i++) {
        camera_update();

        if (get_object_count(CAMERA_CHANNEL) > 0) {
            printf("SOME PINK DETECTED?");
            int area = get_object_area(CAMERA_CHANNEL, 0);

            if (area >= AREA_THRESHOLD) {
                printf("PINK DETECTED! Area = %d\n", area);
                return true;
            }
        }

        msleep(30);
    }

    printf("No pink detected.\n");
    return false;
}


