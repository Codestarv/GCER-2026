// returns true if blue, false if pink
bool drum_is_blue() {
    msleep(100);

    int pink_area = 0;
    int blue_area = 0;

    // average a few frames so one bad read doesn't decide it
    for (int i = 0; i < 5; i++) {
        camera_update();

        if (get_object_count(PINK_CAMERA_CHANNEL) > 0) {
            pink_area += get_object_area(PINK_CAMERA_CHANNEL, 0);
        }
        if (get_object_count(BLUE_CAMERA_CHANNEL) > 0) {
            blue_area += get_object_area(BLUE_CAMERA_CHANNEL, 0);
        }

        msleep(30);
    }

    printf("PINK area = %d, BLUE area = %d\n", pink_area, blue_area);

    return (blue_area > pink_area);   // bigger blue wins b blue, else pink
}
